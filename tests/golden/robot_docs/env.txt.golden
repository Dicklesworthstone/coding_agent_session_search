env:
  CODING_AGENT_SEARCH_NO_UPDATE_PROMPT=1   skip update prompt
  TUI_HEADLESS=1                           skip update prompt
  CASS_DATA_DIR                            override data dir
  CASS_DB_PATH                             override db path
  CASS_OUTPUT_FORMAT=json|jsonl|compact|sessions|toon  default structured output
  CASS_SEARCH_TIMEOUT_MS=<N>               default `cass search`/`pack` timeout in ms (--timeout overrides; 0=none)
  CASS_SEARCH_LIMIT=<N>                    default search/pack limit (--limit overrides; 0=no limit)
  CASS_SEARCH_MODE=lexical|semantic|hybrid default search/pack mode (--mode overrides)
  CASS_STATUS_BUDGET_MS=<N>                robot status budget in ms (default 8000; sheds optional sections after expiry)
  CASS_DOCTOR_BUDGET_MS=<N>                structured doctor reporting budget in ms (default 8000; marks overruns timed_out)
  CASS_FTS_DRYRUN_CAP=<N>                  row-ID comparison cap for bounded canonical FTS dry-run divergence scans (default 4096; positive integer, invalid values use the default)
  CASS_VIEW_BUDGET_MS=<N>                  structured view worker deadline in ms (default 10000)
  CASS_SEARCH_BUDGET_MS=<N>                structured search worker budget in ms (default 120000; a positive effective search timeout overrides)
  CASS_TRIAGE_BUDGET_MS=<N>                robot triage probe budget in ms (default 8000; sheds incomplete readiness sections after expiry)
  CASS_PACK_BUDGET_MS=<N>                  structured pack budget in ms (default 10000; a positive effective search timeout overrides)
  CASS_FLEET_PER_HOST_BUDGET_MS=<N>        per-host source/fleet probe budget in ms (default 8000)
  CASS_FLEET_BUDGET_MS=<N>                 overall source/fleet probe budget in ms (default 60000)
  TOON_DEFAULT_FORMAT=toon|json            fallback structured output for all tools
  TOON_INDENT=<N>                           pretty-print TOON with indent
  TOON_KEY_FOLDING=off|safe                 TOON key folding mode
  CASS_NO_COLOR                            force monochrome
  CASS_RESPECT_NO_COLOR=1                  honor global NO_COLOR
  CASS_TRACE_FILE                          default cass-trace-v1 JSONL path
  CASS_TRACE_FILTER                        trace-file EnvFilter (CASS DEBUG + global WARN/ERROR; redaction memo WARN)
  CASS_TRACE_MAX_BYTES=<N>                 hard trace-file byte ceiling (default 16777216; clamped 4096..1073741824)
  CASS_TRACE_MAX_EVENTS=<N>                hard diagnostic-event ceiling (default 50000; clamped 16..10000000)
  CASS_INDEX_NO_PROGRESS_EVENTS=1          suppress NDJSON events from `cass index --json`
  CASS_INDEX_INGEST_WAL_CHECKPOINT_BYTES=<N>  reset a deferred bulk-ingest WAL after N bytes (default 536870912; 0 disables)
  CASS_INDEX_INGEST_WAL_CHECKPOINT_MODE=PASSIVE|FULL|RESTART|TRUNCATE  in-run bulk WAL checkpoint mode (default TRUNCATE)
  CASS_MIGRATION_LEGACY_FTS_DROP_BUDGET_BYTES=<N>  refuse the unbounded V14 legacy-FTS teardown on archives above N bytes (default 536870912; 0 disables the refusal)
  CASS_DEFER_ANALYTICS_UPDATES=1             defer derived analytics writes during indexing; a pending legacy OMP rebuild resumes on a later run with this unset
  CASS_STORAGE_PROBE_TIMEOUT_MS=<N>        budget for the dedicated typed storage probes on status/search/doctor (default 100; clamped 10..10000) — widen on slow hosts where schema/contention classification times out to `unchecked`
  CASS_RAW_MIRROR=0                        stop copying session files into the raw mirror (default on); indexing continues, doctor reports raw_mirror_capture_disabled
  CASS_AUTO_REFRESH=0                      disable stale-on-read catch-up (detached `cass index --background` after a stale search/pack/TUI launch)
  CASS_AUTO_REFRESH_COOLDOWN_SECS=<N>      min seconds between auto-spawned catch-up runs (default 300)
  CASS_BACKGROUND_NICE=<N>                 nice value for `cass index --background` (default 15)
  CASS_BACKGROUND_IONICE_CLASS=<N>         ionice class for `cass index --background` on Linux (default 3 = idle)
  CASS_DAEMON_INDEX_INTERVAL_SECS=<N>      resident daemon spawns an incremental background index every N s (default 0 = off)
  CASS_SCHEDULE_MAX_BACKFILL_BATCHES=<N>   cap on semantic backfill batches per nightly `cass schedule run` (default 200)
  CASS_SCHEDULE_MAX_LOAD_DEFERRAL_SECS=<N> longest severe load may skip scheduled incremental runs since the last completed one (default 10800; 0 = no limit)
  CASS_RESPONSIVENESS_MIN_USER_IDLE_SECS=<N>  require console idle time before scheduled backfill/nightly jobs (default 0 = off; macOS only, fails open)
  CASS_RESPONSIVENESS_DISABLE=1            pin indexer fan-out at 100% (skip governor)
  CASS_RESPONSIVENESS_MIN_CAPACITY_PCT=<N> floor for governor shrink (default 25, range 10..100)
  CASS_RESPONSIVENESS_MAX_LOAD_PER_CORE=<F>  loadavg/core threshold for step-down (default 1.25)
  CASS_RESPONSIVENESS_SEVERE_LOAD_PER_CORE=<F>  loadavg/core threshold for floor drop (default 1.75)
  CASS_RESPONSIVENESS_MAX_PSI_AVG10=<F>    /proc/pressure/cpu some-avg10 step-down (default 20.0)
  CASS_RESPONSIVENESS_SEVERE_PSI_AVG10=<F>  PSI severe threshold (default 40.0)
  CASS_RESPONSIVENESS_GROWTH_TICKS=<N>     healthy ticks needed before each 25pp grow step (default 3)
  CASS_RESPONSIVENESS_TICK_SECS=<N>        sampler interval in seconds (default 2)
  CASS_RESPONSIVENESS_CALIBRATION=static|conformal  threshold policy (DEFAULT: conformal). Set to `static` to revert to legacy hand-tuned 1.25/20.0 thresholds.
  CASS_RESPONSIVENESS_CONFORMAL_K=<N>      calibration window size (clamped 16..4096, default 256)
  CASS_RESPONSIVENESS_CONFORMAL_K_MIN=<N>  min samples before quantile emits (clamped 4..K, default 32)
  CASS_RESPONSIVENESS_CONFORMAL_ALPHA_PRESSURED=<F>  FP rate for pressured quantile (0<α<0.5, default 0.05)
  CASS_RESPONSIVENESS_CONFORMAL_ALPHA_SEVERE=<F>  FP rate for severe quantile (0<α<pressured, default 0.01)
  CASS_RESPONSIVENESS_DRIFT_DELTA=<F>      Page-Hinkley drift tolerance δ (default 0.01)
  CASS_RESPONSIVENESS_DRIFT_LAMBDA=<F>     Page-Hinkley trigger λ for calibration reset (default 0.5)
  CASS_STREAMING_CONSUMER_COMMIT_SECS=<N>  base streaming-consumer lexical commit cadence (default 5)
  CASS_SEMANTIC_BATCH_SIZE=<N>             embedder batch size (default 128)
  CASS_SEMANTIC_PREP_PARALLEL=1            opt in to rayon-parallel canonicalize+hash prep (default off: serial is measurably faster on the common cheap-embedder path)
  CASS_SEMANTIC_EMBED_BATCH_WARN_AFTER_MS=30000  warn when one embedder batch exceeds the cass#257-derived 30s healthy-run threshold
  CASS_SEMANTIC_EMBED_BATCH_FAIL_AFTER_MS=300000  abort after a returned embedder batch exceeds the cass#257-derived 5m watchdog threshold; 0 disables
  CASS_SEMANTIC_MAX_MESSAGES_PER_CHECKPOINT=10000 cap models backfill checkpoints at whole-conversation prefixes near 10k selected messages; 0 disables
  CASS_SEMANTIC_MAX_BYTES_PER_CHECKPOINT=8388608 cap models backfill checkpoints at whole-conversation prefixes near 8MiB selected content; 0 disables
  CASS_STREAMING_CONSUMER_COMBINE=0        DISABLE flat-combining drain in run_streaming_consumer (Card 3; DEFAULT: on). Any non-off value (unset, 1, true, yes, on) leaves combining enabled.
  CASS_STREAMING_COMBINE_MAX=<N>           max messages per combined drain (clamped 1..1024, default 64)
  CASS_STREAMING_COMBINE_MAX_BYTES=<N>     byte cap per combined drain (clamped 1MiB..STREAMING_MAX, default half)
  CASS_INDEXER_PARALLEL_WAL=off            DISABLE Card 1 parallel-WAL shadow observer (DEFAULT: shadow). Observer records per-chunk wall-clock; does NOT change commit semantics. `on`/`commit` are reserved for a future revision.
  CASS_AIDER_DATA_ROOT=<path>              Aider history location (default ~/.aider.chat.history.md)
  CASS_ALLOW_DUMB_TERM=1                   allow TUI startup even when TERM=dumb
  CASS_AUTOMATIC_WILDCARD_FALLBACK_MAX_DOCS=<N>  max index documents for automatic wildcard fallback on sparse results (default 10000)
  CASS_CACHE_BYTE_CAP=<N>                  search-hit cache byte limit (default available memory / 128, clamped 64 MiB..2 GiB; 0 disables)
  CASS_CACHE_EVICTION_POLICY=lru|s3-fifo   search-hit cache eviction policy (default lru)
  CASS_CACHE_SHARD_CAP=<N>                 per-shard LRU cache entries (default 256)
  CASS_CACHE_TOTAL_CAP=<N>                 total cached search hits (default 2048)
  CASS_DEBUG_CACHE_METRICS=1               enable cache hit/miss logging
  CASS_DISABLE_ANIMATIONS=1                disable UI animations
  CASS_DOCTOR_RAW_MIRROR_FULL_VERIFY=1     hash every raw-mirror descriptor/chunk during read-only doctor runs
  CASS_DOCTOR_RAW_MIRROR_FULL_VERIFY_BYTE_LIMIT=<N>  defer full raw-mirror hashing above this byte count (default 536870912)
  CASS_DOCTOR_RAW_MIRROR_FULL_VERIFY_MANIFEST_LIMIT=<N>  defer full raw-mirror hashing above this manifest count (default 256)
  CASS_DOCTOR_WAL_CHECKPOINT_TIMEOUT_SECS=<N>  wall-clock budget in seconds for `cass doctor --fix` WAL checkpoint (default 120; 0 keeps default)
  CASS_EXCLUDE_PATHS=p1,p2                 comma/newline-delimited files or directory prefixes to skip without advancing scan/watch watermarks
  CASS_FTS_INLINE_BUDGET_SECS=<N>          wall-clock budget in seconds per index run for inline fts_messages shadow writes (default 300; 0 disables)
  CASS_FTS_REPAIR_PAGE_BUDGET_SECS=<N>     per-page budget in seconds for paged fts_messages shadow repair/rebuild (default 120; 0 disables)
  CASS_FTS_SHADOW_MAX_MESSAGES=<N>         max indexable message count for retaining the fts_messages SQL-fallback shadow (default 100000; 0 disables)
  CASS_INCREMENTAL_AUTHORITATIVE_LEXICAL_REPAIR_MAX_DB_BYTES=<N>  max archive bytes for inline authoritative lexical repair during search/index (default 1073741824 = 1 GiB)
  CASS_INDEX_FINALIZE_ABORT_SECS=<N>       abort grace in seconds during finalize WAL-checkpoint / rebuild-tail windows (default 1800; 0 report-only)
  CASS_INDEX_FINAL_WAL_CHECKPOINT_TIMEOUT_SECS=<N>  wall-clock budget in seconds for final wal_checkpoint(TRUNCATE) during index (default 900; 0 keeps default)
  CASS_INDEX_REDACTION=full|off            index-time secret redaction mode (default full)
  CASS_INDEX_SKIP_DISK_HEADROOM_CHECK=1    skip free-space preflight before `cass index --full` / `--force-rebuild`
  CASS_INDEX_STALL_ABORT_ALL_PHASES=1      promote stall watchdog warnings to hard abort (exit 70) in all phases
  CASS_INDEX_STALL_ABORT_SECS=<N>          seconds without progress before abort-eligible lexical stall exits 70 (default 300; 0 report-only)
  CASS_INDEX_STALL_DETECT_SECS=<N>         seconds without phase progress before emitting stall diagnostics (default 120; 0 disables)
  CASS_LEXICAL_MAX_MESSAGE_CONTENT_BYTES=<N>  max bytes of any single message indexed into the lexical index (default 8388608 = 8 MiB)
  CASS_LEXICAL_MERGE_MAX_OUTPUT_BYTES=<N>  max estimated output bytes per lexical merge run (default 1073741824 = 1 GiB)
  CASS_MUSE_DATA_ROOT=<path>               Muse Code data root (default ~/.local/share/muse)
  CASS_OMP_DATA_ROOT=<path>                OMP-only archive/store root override
  CASS_QUILL_QUERY_FUEL_BUDGET=<N>         deterministic per-query work ceiling for Quill lexical queries (default 10000000)
  CASS_REDACT_MEMO_CAPACITY=<N>            per-worker redaction memo cache entry cap during batched persist (default 4096)
  CASS_REDACT_SECRETS=0|1                  legacy redaction toggle (default 1; CASS_INDEX_REDACTION takes precedence)
  CASS_RESPONSIVENESS_MAX_INFLIGHT_BYTES=<N>  governor ceiling on in-flight message bytes across indexing (default RAM/32 clamped 512 MiB..16 GiB)
  CASS_RESPONSIVENESS_MAX_WORKERS=<N>      hard ceiling the load/PSI governor applies to indexing worker pools
  CASS_SEARCH_ACTIVE_REBUILD_WAIT_MS=<N>   max ms search waits for an active lexical rebuild before returning index-busy (default 30000)
  CASS_SEARCH_EXACT_TOTAL_COUNT_MAX_DOCS=<N>  max index documents for computing exact total_matches on a full page (default 5000000; 0 disables)
  CASS_SEMANTIC_EMBEDDER=hash|minilm|multilingual-minilm  force semantic embedder backend (default auto)
  CASS_SEMANTIC_PROGRESS_JSONL=<path>      append semantic backfill phase transition events as JSONL to <path>
  CASS_SSH_CONFIG=<path>                   SSH config file passed as `ssh -F <path>` for remote sources
  CASS_TANTIVY_REBUILD_BATCH_FETCH_CONVERSATIONS=<N>  conversations per SQL message-fetch chunk during lexical rebuild
  CASS_TANTIVY_REBUILD_COMMIT_EVERY_CONVERSATIONS=<N>  steady-state durable-commit interval in conversations (default 10000)
  CASS_TANTIVY_REBUILD_COMMIT_EVERY_MESSAGES=<N>       steady-state durable-commit interval in messages (default 800000)
  CASS_TANTIVY_REBUILD_COMMIT_EVERY_MESSAGE_BYTES=<N>  steady-state durable-commit interval in message bytes (default 536870912)
  CASS_TANTIVY_REBUILD_INITIAL_BATCH_FETCH_CONVERSATIONS=<N>  chunk size for the first durable rebuild slice (default 32)
  CASS_TANTIVY_REBUILD_INITIAL_COMMIT_EVERY_CONVERSATIONS=<N>  initial durable-commit interval in conversations (default 2048)
  CASS_TANTIVY_REBUILD_INITIAL_COMMIT_EVERY_MESSAGES=<N>       initial durable-commit interval in messages (default 800000)
  CASS_TANTIVY_REBUILD_INITIAL_COMMIT_EVERY_MESSAGE_BYTES=<N>  initial durable-commit interval in message bytes (default 134217728)
  CASS_TANTIVY_REBUILD_PAGE_PREP_WORKERS=<N>  threads fetching and preparing conversation pages ahead of lexical writers
  CASS_TANTIVY_REBUILD_PIPELINE_CHANNEL_SIZE=<N>  prepared pages queued between page prep and lexical writers (default 4)
  CASS_TANTIVY_REBUILD_PIPELINE_MAX_MESSAGE_BYTES_IN_FLIGHT=<N>  cap on message bytes held in flight across the rebuild pipeline
  CASS_TANTIVY_REBUILD_RESERVED_CORES=<N>  CPU cores reserved outside the lexical rebuild worker pool
  CASS_TANTIVY_REBUILD_WORKERS=<N>         writer/shard-builder threads for lexical rebuild (default cores - reserved, clamped 1..64)
  CASS_WARM_DEBOUNCE_MS=<N>                warm-up search debounce in ms (default 120)
