# UBS ignore patterns
# Files and directories that should not be scanned for bugs

# Build artifacts
target/

# AI coding tool artifacts
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v3/

# Temporary scratch files
temp_*.rs

# Test fixtures (not production code)
tests/fixtures/
tests/golden/html_export/*.golden

# Lock files (auto-generated)
Cargo.lock

# Third-party Pages vendor artifacts, pinned byte for byte by size and SHA-256
# in src/pages/bundle.rs and src/pages_assets/vendor/manifest.json. They are
# never edited or formatted here, so a finding in them cannot be fixed in-tree.
src/pages_assets/vendor/

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.venv/

# Claude Code artifacts
.claude/

# Local backup directories
.local_backup_*/
