+        assert_eq!(calls, 1, "setup retries must never replay an arbitrary writer body");
+        assert_eq!(scalar(&storage, "SELECT COUNT(*) FROM meta WHERE key = 'gh473-side-effect'"), 1);
+        storage.close().unwrap();
+    }
