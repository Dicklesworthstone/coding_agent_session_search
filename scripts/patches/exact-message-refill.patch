+            shard_count = context.artifacts.len(),
+            rounds,
+            returned = hits.len(),
+            "exact semantic message refinement complete"
+        );
+        Ok((hits, SemanticCandidateRetryState {
+            has_more_candidates,
+            exact_window_may_omit_competitor: false,
+        }))
+    }
