+struct HashAwareCountingFilter {
+    hashes: AtomicUsize,
+    strings: AtomicUsize,
+}
+impl HashAwareCountingFilter {
+    fn new() -> Self {
+        Self { hashes: AtomicUsize::new(0), strings: AtomicUsize::new(0) }
+    }
+}
+impl FsSearchFilter for HashAwareCountingFilter {
+    fn matches(&self, _: &str, _: Option<&serde_json::Value>) -> bool {
+        self.strings.fetch_add(1, AtomicOrdering::Relaxed);
+        true
+    }
+    fn matches_doc_id_hash(&self, _: u64, _: Option<&serde_json::Value>) -> Option<bool> {
+        self.hashes.fetch_add(1, AtomicOrdering::Relaxed);
+        Some(true)
+    }
+    fn name(&self) -> &str { "count-native-and-message-selection-separately" }
+}
