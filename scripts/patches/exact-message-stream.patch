+#[test]
+fn streaming_unresolved_wal_window_uses_complete_message_refinement() -> Result<()> {
+    let tmp = tempfile::tempdir()?;
+    for dimension in [32, 33] {
+        let path = tmp.path().join(format!("unresolved-{dimension}.fsvi"));
+        let rows: Vec<_> = (1..=16_u64).flat_map(|id| (0..=31_u8).map(move |chunk|
+            (doc(id, chunk, 3), vector(dimension, 1.0 - id as f32 / 32.0)))).collect();
+        drop(write_artifact(&path, dimension, Quantization::F32, &rows)?);
+        let mut writer = FsVectorIndex::open_writer(&path)?;
+        writer.append_batch(&[(doc(100, 0, 3), vector(dimension, -0.5))])?;
+        drop(writer);
+        let ctx = context(vec![SemanticIndexArtifact::open(&path, None)?]);
+        let query = vector(dimension, 1.0);
+        let (_, initial_retry) = SearchClient::search_exact_semantic_indexes_initial_window(
+            &ctx, &query, 2, None)?;
+        assert!(initial_retry.exact_window_may_omit_competitor);
+        let scope = HashAwareCountingFilter::new();
+        let (live, retry) = SearchClient::search_exact_semantic_indexes(
+            &ctx, &query, 2, Some(&scope))?;
+        assert_eq!(signature(&live), oracle(&ctx.artifacts, &query, 8, None)?);
+        assert!(!retry.exact_window_may_omit_competitor);
+        assert!(scope.hashes.load(AtomicOrdering::Relaxed) > 0);
+        assert_eq!(scope.strings.load(AtomicOrdering::Relaxed), rows.len() + 1,
+            "exactly one complete message refinement must follow the native window");
+    }
+    Ok(())
+}
