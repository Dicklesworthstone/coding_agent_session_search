+#[test]
+fn streaming_wal_queries_keep_a_proven_native_first_window() -> Result<()> {
+    let tmp = tempfile::tempdir()?;
+    // Cover both the optimized collector and the legacy-width/large-WAL lane.
+    for (dimension, delta_count) in [(32, 1), (33, 4100)] {
+        let path = tmp.path().join(format!("proven-{dimension}.fsvi"));
+        let rows: Vec<_> = (1..=32_u64).map(|id|
+            (doc(id, 0, 3), vector(dimension, 1.0 - id as f32 / 64.0))).collect();
+        drop(write_artifact(&path, dimension, Quantization::F32, &rows)?);
+        let mut writer = FsVectorIndex::open_writer(&path)?;
+        let delta: Vec<_> = (0..delta_count).map(|id|
+            (doc(1000 + id, 0, 3), vector(dimension, -0.5))).collect();
+        writer.append_batch(&delta)?;
+        drop(writer);
+        let ctx = context(vec![SemanticIndexArtifact::open(&path, None)?]);
+        let query = vector(dimension, 1.0);
+        let initial_count = HashAwareCountingFilter::new();
+        let (initial, initial_retry) = SearchClient::search_exact_semantic_indexes_initial_window(
+            &ctx, &query, 2, Some(&initial_count))?;
+        assert!(!initial_retry.exact_window_may_omit_competitor,
+            "the first window must actually prove this request");
+        assert!(initial_count.hashes.load(AtomicOrdering::Relaxed) > 0);
+        let live_count = HashAwareCountingFilter::new();
+        let (live, live_retry) = SearchClient::search_exact_semantic_indexes(
+            &ctx, &query, 2, Some(&live_count))?;
+        assert_eq!(signature(&live), signature(&initial));
+        assert_eq!(signature(&live), oracle(&ctx.artifacts, &query, 8, None)?);
+        assert_eq!(live_retry.has_more_candidates, initial_retry.has_more_candidates);
+        assert!(!live_retry.exact_window_may_omit_competitor);
+        assert_eq!(live_count.hashes.load(AtomicOrdering::Relaxed),
+            initial_count.hashes.load(AtomicOrdering::Relaxed));
+        assert_eq!(live_count.strings.load(AtomicOrdering::Relaxed),
+            initial_count.strings.load(AtomicOrdering::Relaxed),
+            "a proven WAL query must not launch a second message-level scan");
+    }
+    Ok(())
+}
